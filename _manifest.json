{
  "manifest_version": 2,
  "id": "com.maimai.personal-assistant",
  "version": "1.0.0",
  "name": "个人备忘助手",
  "description": "让麦麦记住你的提醒：通过艾特 bot 或 /备忘 指令创建定时备忘任务，到期后麦麦用 LLM 生成真人化提醒（私聊优先、无好友则群聊@），支持携带图片/文件附件；任务持久化到插件数据目录，麦麦重启后自动恢复并继续运行，完成后自动清理附件与任务记录。",
  "author": {
    "name": "LDrumDusk",
    "url": "https://github.com/LDrumDusk"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/LDrumDusk/maibot_personal_assistant",
    "homepage": "https://github.com/LDrumDusk/maibot_personal_assistant",
    "documentation": "https://github.com/LDrumDusk/maibot_personal_assistant/blob/main/README.md",
    "issues": "https://github.com/LDrumDusk/maibot_personal_assistant/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.21.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.13.0"
    }
  ],
  "plugin_type": "tool",
  "capabilities": [
    "config.get",
    "llm.generate",
    "llm.generate_with_tools",
    "send.text",
    "send.image",
    "send.custom",
    "chat.get_stream_by_user_id",
    "chat.get_stream_by_group_id",
    "message.get_by_id",
    "message.get_recent",
    "message.build_readable"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
